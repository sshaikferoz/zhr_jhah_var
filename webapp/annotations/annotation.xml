<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="/sap/opu/odata4/sap/zhr_var_app_srv_bind/srvd/sap/zhr_var_app_srv_defn/0001/$metadata">
        <edmx:Include Namespace="com.sap.gateway.srvd.zhr_var_app_srv_defn.v0001" Alias="SAP__self"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">

            <!-- Dynamic placeholder for IdNum based on the selected IdTyp value.
                 Note: {@i18n>} cannot be used inside edm:If branches — literal strings required. -->
            <Annotations Target="SAP__self.VisitorDetailsType/IdNum">
                <Annotation Term="UI.Placeholder">
                    <If>
                        <Eq>
                            <Path>IdTyp</Path>
                            <String>GOV</String>
                        </Eq>
                        <String>1NNNNNNNNNN</String>
                        <If>
                            <Eq>
                                <Path>IdTyp</Path>
                                <String>IQM</String>
                            </Eq>
                            <String>2NNNNNNNNN</String>
                            <String>Enter ID Number</String>
                        </If>
                    </If>
                           </Annotation>
            </Annotations>
            <Annotations Target="SAP__self.VarListType">
                <Annotation Term="UI.FieldGroup" Qualifier="AcknoJustify">
                    <Record>
                        <PropertyValue Property="Data">
                            <Collection>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="AcknoFlag"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="justification"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="AuthPernr"/>
                                    <Annotation Term="UI.Hidden"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="AuthTim"/>
                                    <Annotation Term="UI.Hidden"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <!--
                    LineItem override: this replaces the whole backend UI.LineItem collection,
                    so every column below is reproduced verbatim from the backend metadata — keep
                    this in sync if the backend LineItem changes.
                    The two toolbar actions ("Copy Request" and "Maintain Locations") are shown
                    ONLY to admins, driven purely by annotation: UI.Hidden with Ne(IsAdmin, 'X').
                    IsAdmin is a VarList property carrying the logged-in user's admin flag ('X' for
                    admins); it is the same on every row, so it acts as the user-level flag.
                    (EmployeeHeader/Admin cannot be used here: there is no navigation from VarList
                    to EmployeeHeader, so annotation expressions cannot reach it.)
                    NOTE: for the expression to evaluate, IsAdmin must be present in the table's
                    OData response. autoExpandSelect only requests fields bound in the UI, so a
                    statically hidden IsAdmin DataField is included below to force it into $select.
                -->
                <Annotation Term="UI.LineItem">
                    <Collection>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="ReqNum"/>
                        </Record>
                        <!-- Hidden helper column: forces IsAdmin into the OData $select so the
                             admin-only UI.Hidden expressions on the actions below can evaluate. -->
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="IsAdmin"/>
                            <Annotation Term="UI.Hidden" Bool="true"/>
                        </Record>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="Copy Request"/>
                            <PropertyValue Property="Action" String="com.sap.gateway.srvd.zhr_var_app_srv_defn.v0001.CopyRequest(com.sap.gateway.srvd.zhr_var_app_srv_defn.v0001.VarListType)"/>
                            <PropertyValue Property="InvocationGrouping" EnumMember="UI.OperationGroupingType/Isolated"/>
                            <!-- Show only to admins: hide when IsAdmin is not 'X'. -->
                            <Annotation Term="UI.Hidden">
                                <Ne>
                                    <Path>IsAdmin</Path>
                                    <String>X</String>
                                </Ne>
                            </Annotation>
                        </Record>
                        <Record Type="UI.DataFieldForIntentBasedNavigation">
                            <PropertyValue Property="Label" String="Maintain Locations"/>
                            <PropertyValue Property="SemanticObject" String="MaintVisitorLocation"/>
                            <PropertyValue Property="Action" String="manage"/>
                            <PropertyValue Property="RequiresContext" Bool="false"/>
                            <!-- Show only to admins: hide when IsAdmin is not 'X'. -->
                            <Annotation Term="UI.Hidden">
                                <Ne>
                                    <Path>IsAdmin</Path>
                                    <String>X</String>
                                </Ne>
                            </Annotation>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Type"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="MeansTrans"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Begda"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Endda"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Criticality" Path="StatsCriticality"/>
                            <PropertyValue Property="CriticalityRepresentation" EnumMember="UI.CriticalityRepresentationType/WithIcon"/>
                            <PropertyValue Property="Value" Path="Status"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="VendorName"/>
                        </Record>
                        <Record Type="UI.DataFieldWithUrl">
                            <PropertyValue Property="Label" String="View Request Form"/>
                            <PropertyValue Property="IconUrl" String="sap-icon://pdf-attachment"/>
                            <PropertyValue Property="Value" Path="ViewPDFText"/>
                            <PropertyValue Property="Url" Path="ViewPDF"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>