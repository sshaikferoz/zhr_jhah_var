{
  "_version": "1.60.0",
  "sap.app": {
    "id": "com.jhah.zhrjhahvar",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.23.0",
      "toolsId": "bbcb51b4-039c-4820-b2af-5ba495608941"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zhr_var_app_srv_bind/srvd/sap/zhr_var_app_srv_defn/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.39",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.jhah.zhrjhahvar.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "services": {
      "ShellUIService": {
        "factoryName": "sap.ushell.ui5service.ShellUIService",
        "settings": {
          "setTitle": "false"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "VarListList",
          "target": [
            "VarListList"
          ]
        },
        {
          "pattern": "VarList({key}):?query:",
          "name": "VarListObjectPage",
          "target": "VarListObjectPage"
        },
        {
          "pattern": "VarList({key})/_VisitorDetails({key2}):?query:",
          "name": "VisitorDetailsObjectPage",
          "target": "VisitorDetailsObjectPage"
        }
      ],
      "targets": {
        "VarListList": {
          "type": "Component",
          "id": "VarListList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/VarList",
              "variantManagement": "Page",
              "navigation": {
                "VarList": {
                  "detail": {
                    "route": "VarListObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "columns": {
                    "DataField::ReqNum": {
                      "width": "7rem"
                    },
                    "DataField::Type": {
                      "width": "7rem"
                    },
                    "DataField::MeansTrans": {
                      "width": "10rem"
                    },
                    "DataField::Begda": {
                      "width": "10rem"
                    },
                    "DataField::Endda": {
                      "width": "10rem"
                    },
                    "DataField::Status": {
                      "width": "10rem"
                    },
                    "DataField::VendorName": {
                      "width": "10rem"
                    },
                    "DataFieldWithUrl::ViewPDFText": {
                      "width": "10rem"
                    }
                  }
                }
              }
            }
          }
        },
        "VarListObjectPage": {
          "type": "Component",
          "id": "VarListObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/VarList",
              "navigation": {
                "_VisitorDetails": {
                  "detail": {
                    "route": "VisitorDetailsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_VisitorDetails/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "creationMode": {
                      "name": "Inline"
                    }
                  },
                  "columns": {
                    "DataField::VisName": {
                      "width": "10rem"
                    },
                    "DataField::IdTyp": {
                      "width": "10rem"
                    },
                    "DataField::IdNum": {
                      "width": "10rem"
                    },
                    "DataField::Natio": {
                      "width": "15rem"
                    },
                    "DataField::IdExpDate": {
                      "width": "8rem"
                    },
                    "DataField::Email": {
                      "width": "12rem"
                    },
                    "DataField::PrimaryContact": {
                      "width": "5rem"
                    },
                    "DataField::daysinyear": {
                      "width": "5rem"
                    }
                  }
                },
                "_VehicleDetails/@com.sap.vocabularies.UI.v1.LineItem": {
                  "columns": {
                    "DataField::ReqNum": {
                      "width": "2rem"
                    },
                    "DataField::PlateTyp": {
                      "width": "10rem"
                    },
                    "DataField::Manufacturer": {
                      "width": "10rem"
                    },
                    "DataField::Color": {
                      "width": "10rem"
                    },
                    "DataField::PlateNum1": {
                      "width": "7rem"
                    },
                    "DataField::PlateNum2": {
                      "width": "7rem"
                    },
                    "DataField::PlateNum3": {
                      "width": "7rem"
                    },
                    "DataField::PlateNum": {
                      "width": "10rem"
                    },
                    "DataField::ArabicPlateNum": {
                      "width": "10rem"
                    }
                  }
                },
                "_ApprovalHist/@com.sap.vocabularies.UI.v1.LineItem": {
                  "columns": {
                    "DataField::Appseq": {
                      "width": "4rem"
                    },
                    "DataField::Approvernames": {
                      "width": "15rem"
                    },
                    "DataField::PositionText": {
                      "width": "15rem"
                    },
                    "DataField::Ename": {
                      "width": "10rem"
                    },
                    "DataField::Actionedby": {
                      "width": "10rem"
                    },
                    "DataField::Statustx": {
                      "width": "10rem"
                    },
                    "DataField::ActionDate": {
                      "width": "8rem"
                    }
                  }
                }
              }
            }
          }
        },
        "VisitorDetailsObjectPage": {
          "type": "Component",
          "id": "VisitorDetailsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/VarList/_VisitorDetails"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.jhah.zhrjhahvar.ext.controller.CustomHeader"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
